# 避免 XFCE 会话里弹出"需要授权"的颜色管理 / 磁盘挂载对话框
[Let users manage color devices]
Identity=unix-user:*
Action=org.freedesktop.color-manager.*
ResultAny=yes
ResultInactive=yes
ResultActive=yes

[Let users mount removable devices]
Identity=unix-user:*
Action=org.freedesktop.udisks2.*
ResultAny=yes
ResultInactive=yes
ResultActive=yes
